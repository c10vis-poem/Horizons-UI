# Gradle
.gradle/
build/
*/build/
!gradle/wrapper/gradle-wrapper.jar

# Claude Code session state (agent worktrees, local settings) — but
# hooks/settings ARE meant to be committed and shared across sessions,
# so carve those out explicitly.
.claude/*
!.claude/hooks/
!.claude/hooks/**
!.claude/settings.json

# Android Studio / IntelliJ
.idea/
*.iml
captures/
.cxx/

# Local config & secrets (NEVER commit keys — see Architecture §12)
local.properties
*.keystore
!app/debug.keystore
!release/debug.keystore
*.jks
google-services.json
service-account*.json
secrets.properties

# On-device model weights — never committed (Architecture §4 / §7)
*.nexa
*.gguf

# Local-only AAR drops — sherpa-onnx AAR fetched by the downloadSherpaAar
# gradle task, never committed; keep any locally-built AAR out of the tree.
horizons/libs/

# Kokoro TTS voice pack — fetched from Hugging Face by the "Download Kokoro
# TTS voice pack" CI step, never committed (134 MB+, would bloat the repo
# permanently). Local builds must fetch it themselves; see build-apk.yml.
horizons/src/main/assets/sherpa_tts/

# OS
.DS_Store
Thumbs.db

# Logs / build artifacts
*.log
interaction_logs.jsonl
*.apk
*.aab
