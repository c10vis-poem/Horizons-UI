<?xml version="1.0" encoding="utf-8"?>
<!--
  Orbitron variable font pinned to wght 400.
  Declared in XML rather than via Compose's FontVariation API, which is
  @ExperimentalTextApi and fails this module's opt-in check.
-->
<font-family xmlns:android="http://schemas.android.com/apk/res/android">
    <font
        android:font="@font/orbitron_variable"
        android:fontStyle="normal"
        android:fontVariationSettings="'wght' 400"
        android:fontWeight="400" />
</font-family>
